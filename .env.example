# whenue-api GraphQL endpoint (Netflix DGS serves /graphql on port 8080 by default).
# On a physical device, use your machine's LAN IP instead of localhost.
EXPO_PUBLIC_GRAPHQL_URL=http://localhost:8080/graphql

# Video upload endpoint. Accepts multipart/form-data with a "video" field and
# returns JSON with a download_url (vidEngine's POST /upload contract).
EXPO_PUBLIC_UPLOAD_URL=http://localhost:3000/upload
