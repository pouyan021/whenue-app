# whenue-api GraphQL endpoint (Netflix DGS serves /graphql on port 8080 by default).
# localhost works on the iOS Simulator, and on the Android emulator after
# `adb reverse tcp:8080 tcp:8080`. On a physical device, use your machine's LAN IP.
EXPO_PUBLIC_GRAPHQL_URL=http://localhost:8080/graphql

# Videos go straight to object storage through presigned URLs from whenue-api, so the
# storage host is configured on the API (WHENUE_S3_PUBLIC_ENDPOINT), not here.
