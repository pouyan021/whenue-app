{
  "expo": {
    "name": "Whenue",
    "slug": "whenue-app",
    "scheme": "whenue",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.whenue.app"
    },
    "android": {
      "package": "com.whenue.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "Whenue برای ضبط ویدیوی تجربه شما از دوربین استفاده می‌کند.",
          "microphonePermission": "Whenue برای ضبط صدای ویدیوی تجربه شما از میکروفون استفاده می‌کند.",
          "recordAudioAndroid": true
        }
      ],
      "expo-secure-store",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
